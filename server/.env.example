PORT=5000
MONGO_URI=mongodb://localhost:27017/ai-job-portal
JWT_SECRET=change_this_to_a_long_random_string

# Used by /api/ai/* routes (analyze-resume, generate-summary, improve-text,
# generate-bullets, match-job)
OPENAI_API_KEY=sk-...
