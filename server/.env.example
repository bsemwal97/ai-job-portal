JWT_SECRET=change_this_to_a_long_random_string

# Frontend URL(s) allowed to call this API (comma-separated)
CLIENT_URL=http://localhost:5173

# Used by /api/ai/* routes. Without it the AI routes return a 503 and everything else still works.
OPENAI_API_KEY=sk-...
# Optional override, defaults to gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini
# Optional: use another OpenAI-compatible provider, e.g. Google Gemini (free tier).
# Then put that provider's key in OPENAI_API_KEY and its model name in OPENAI_MODEL.
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Email (forgot password + application status emails).
# Leave SMTP_HOST empty in development: emails are printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AI Job Portal <no-reply@example.com>"
