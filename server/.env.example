PORT=5000
MONGO_URI=mongodb://localhost:27017/ai-job-portal
JWT_SECRET=change_this_to_a_long_random_string

# Frontend URL(s) allowed to call this API (comma-separated)
CLIENT_URL=http://localhost:5173

# Used by /api/ai/* routes. Without it the AI routes return a 503 and everything else still works.
OPENAI_API_KEY=sk-...
# Optional override, defaults to gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini
